{
  "name": "Python 3",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md", "SYSTEM_DETAILED_GUIDE.md"]
    },
    "vscode": {
      "settings": {},
      "extensions": ["ms-python.python", "ms-python.vscode-pylance"]
    }
  },
  "updateContentCommand": "[ -f requirements-dev.txt ] && pip3 install --user -r requirements-dev.txt; echo 'Requirements met'",
  "postAttachCommand": {
    "server": "uvicorn trading.api.app:create_app --factory --host 0.0.0.0 --port 8000 --reload"
  },
  "portsAttributes": {
    "8000": {
      "label": "FastAPI backend",
      "onAutoForward": "notify"
    }
  },
  "forwardPorts": [8000]
}
