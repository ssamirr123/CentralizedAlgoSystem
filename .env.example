# Local Docker stack configuration (docker-compose.yml).
#
#   cp .env.example .env
#   # edit .env -- at minimum change POSTGRES_PASSWORD and CONTROL_API_KEY
#   docker compose up --build
#
# docker compose reads this file automatically for ${VAR} substitution.
# NEVER commit a real .env. Placeholders only below.

# --- PostgreSQL (the "postgres" service) ------------------------------
POSTGRES_USER=algo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=centralized_algo

# --- Backend ---------------------------------------------------------
# Must point at the compose "postgres" service. Keep user/password/db in
# sync with the three POSTGRES_* values above.
DATABASE_URL=postgresql://algo:change-me@postgres:5432/centralized_algo

# Shared API key for /api/* (auth fails closed if blank).
CONTROL_API_KEY=dev-control-key

# Safety gate -- must be exactly "live" to permit real orders. Leave paper.
TRADING_MODE=paper

APP_ENV=docker
LOG_LEVEL=INFO
BACKEND_PORT=8000

# Long-lived container -> keep the stale-heartbeat watcher ON (leave blank).
DISABLE_BACKGROUND_WATCHER=

# --- Optional integrations (leave blank unless used) ----------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
AWS_REGION=ap-south-1
LAMBDA_FUNCTION_NAME=

# --- Stage 19 market-data engine (ICICI Breeze) --------------------
# Opt-in. Nothing contacts Breeze unless MARKET_DATA_ENABLED is truthy.
# Credentials are secrets -- fill them on the box / via AWS Secrets
# Manager, NEVER commit real values here.
MARKET_DATA_ENABLED=
MARKET_DATA_TIMEZONE=Asia/Kolkata
MARKET_DATA_START_TIME=09:10
MARKET_DATA_STOP_TIME=15:45
NIFTY_OPTION_STRIKE_RANGE=10
BREEZE_API_KEY=
BREEZE_SECRET_KEY=
BREEZE_SESSION_TOKEN=
BREEZE_SECRET_ID=

# --- AngelOne SmartAPI (the three real strategies) ----------------
# Read by trading/algos/*/config.py::_angel_creds(). Placeholders only.
ANGELONE_API_KEY=
ANGELONE_CLIENT_ID=
ANGELONE_MPIN=
ANGELONE_TOTP_SECRET=

# =====================================================================
# AI Research Platform (Phases 5-10) -- Phase 11 production hardening
# =====================================================================
# Every AI/LLM-driven feature below is OFF until AI_RESEARCH_ENABLED is
# explicitly set true. None of it can place, modify, or cancel a broker
# order, start/stop a strategy, or change TRADING_MODE/account routing --
# see docs/ai-research-safety-boundary.md.

# --- Feature Flags ---------------------------------------------------
# Master switch -- fails CLOSED (blank/unset = disabled). Governs AI
# Research, AI Backtesting, and AI Options Research together.
AI_RESEARCH_ENABLED=false

# Global AI-workload kill switch (Section 5) -- DIFFERENT from
# TRADING_MODE and unrelated to it. Fails OPEN (blank = on, i.e. no
# effect) so normal operation needs no change here; during an incident,
# set this to false to instantly stop ALL new AI job submissions
# (research/backtest/options-research) while leaving the existing
# Trading Control Center, broker connectivity, and read access to
# already-persisted AI history/reports completely unaffected.
AI_WORKLOADS_ENABLED=true

# Independent per-capability narrowing (Section 4) -- each fails OPEN;
# set to false only to disable that ONE capability while leaving the
# others (and AI_RESEARCH_ENABLED itself) untouched.
AI_BACKTEST_ENABLED=true
AI_OPTIONS_RESEARCH_ENABLED=true

# Deterministic, non-LLM options analytics (Phase 9) -- independent of
# every AI_* flag above (no LLM cost). Fails OPEN.
OPTIONS_INTELLIGENCE_ENABLED=true

# --- LLM Providers -----------------------------------------------------
# Provider name passed to TradingAgents' own llm_clients factory
# (openai | anthropic | google | groq | xai | deepseek | ... -- see
# trading/ai_research/schemas.py::SUPPORTED_LLM_PROVIDERS for the full list).
AI_RESEARCH_LLM_PROVIDER=openai
# The provider's OWN API key env var is read lazily by TradingAgents
# itself (e.g. OPENAI_API_KEY, GROQ_API_KEY, ANTHROPIC_API_KEY) -- never
# read or stored by this application's own config. Set whichever your
# AI_RESEARCH_LLM_PROVIDER needs.
OPENAI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# --- Market Data (Options Intelligence / AI Research India bridge) ---
NIFTY_OPTION_STRIKE_RANGE=10
SENSEX_OPTION_STRIKE_RANGE=10
MARKET_DATA_STALE_SECONDS=10
MARKET_WS_UPDATE_INTERVAL_MS=1000
MARKET_DATA_RETENTION_DAYS=365
OPTION_DATA_RETENTION_DAYS=180
MARKET_DATA_MAX_BACKFILL_DAYS=30
MARKET_DATA_MAX_PROVIDER_CALLS=5
OPTIONS_CHAIN_STRIKE_WINDOW=5
OPTIONS_RISK_FREE_RATE=0.065
OPTIONS_SNAPSHOT_CACHE_SECONDS=5

# --- Concurrency / Timeouts -------------------------------------------
# Each is a hard cap enforced BEFORE expensive work begins (Section 12/13).
AI_RESEARCH_MAX_CONCURRENT=1
AI_RESEARCH_TIMEOUT_SECONDS=300
AI_OPTIONS_MAX_CONCURRENT=1
AI_OPTIONS_TIMEOUT_SECONDS=420
AI_OPTIONS_MAX_DEBATE_ROUNDS=3
AI_OPTIONS_MAX_CANDIDATES=5

# --- AI Backtesting cost guards ---------------------------------------
AI_BACKTEST_MAX_SYMBOLS=3
AI_BACKTEST_MAX_DATES=12
AI_BACKTEST_MAX_RUNS=20
AI_BACKTEST_MAX_CONCURRENT=1
AI_BACKTEST_HOLDING_DAYS=5

# --- Retention / Storage ----------------------------------------------
# Where TradingAgents' own cache/checkpoint/memory files are written
# (never the OS user's home directory default -- containment only).
AI_RESEARCH_DATA_DIR=

# --- Logging -----------------------------------------------------------
# (LOG_LEVEL is set once, near the top of this file, for the whole app.)
