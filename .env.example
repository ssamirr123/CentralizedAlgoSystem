# Local Docker stack configuration (docker-compose.yml).
#
#   cp .env.example .env
#   # edit .env -- at minimum change POSTGRES_PASSWORD and CONTROL_API_KEY
#   docker compose up --build
#
# docker compose reads this file automatically for ${VAR} substitution.
# NEVER commit a real .env. Placeholders only below.

# --- PostgreSQL (the "postgres" service) ------------------------------
POSTGRES_USER=algo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=centralized_algo

# --- Backend ---------------------------------------------------------
# Must point at the compose "postgres" service. Keep user/password/db in
# sync with the three POSTGRES_* values above.
DATABASE_URL=postgresql://algo:change-me@postgres:5432/centralized_algo

# Shared API key for /api/* (auth fails closed if blank).
CONTROL_API_KEY=dev-control-key

# Safety gate -- must be exactly "live" to permit real orders. Leave paper.
TRADING_MODE=paper

APP_ENV=docker
LOG_LEVEL=INFO
BACKEND_PORT=8000

# Long-lived container -> keep the stale-heartbeat watcher ON (leave blank).
DISABLE_BACKGROUND_WATCHER=

# --- Optional integrations (leave blank unless used) ----------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
AWS_REGION=ap-south-1
LAMBDA_FUNCTION_NAME=

# --- Stage 19 market-data engine (ICICI Breeze) --------------------
# Opt-in. Nothing contacts Breeze unless MARKET_DATA_ENABLED is truthy.
# Credentials are secrets -- fill them on the box / via AWS Secrets
# Manager, NEVER commit real values here.
MARKET_DATA_ENABLED=
MARKET_DATA_TIMEZONE=Asia/Kolkata
MARKET_DATA_START_TIME=09:10
MARKET_DATA_STOP_TIME=15:45
NIFTY_OPTION_STRIKE_RANGE=10
BREEZE_API_KEY=
BREEZE_SECRET_KEY=
BREEZE_SESSION_TOKEN=
BREEZE_SECRET_ID=

# --- AngelOne SmartAPI (the three real strategies) ----------------
# Read by trading/algos/*/config.py::_angel_creds(). Placeholders only.
ANGELONE_API_KEY=
ANGELONE_CLIENT_ID=
ANGELONE_MPIN=
ANGELONE_TOTP_SECRET=
