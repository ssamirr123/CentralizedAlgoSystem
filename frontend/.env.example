# Copy to .env.local and adjust. All build-time; prefix must stay VITE_.

# Where `npm run dev` proxies /api, /strategies, /health.
# Point at your backend origin (no trailing slash).
VITE_API_PROXY_TARGET=http://13.206.203.145

# Trading mode this build targets. Drives the always-on PAPER / LIVE banner
# and every command-confirmation dialog. Anything other than the exact
# string "live" is treated as paper (fail safe).
#   paper  -> green "PAPER TRADING" banner
#   live   -> red "LIVE TRADING" banner (live order execution is NOT
#             implemented in this foundation regardless of this value)
VITE_TRADING_MODE=paper

# Optional: default API base URL the app calls. Leave blank to use relative
# `/api` (works behind nginx in prod and the dev proxy). Set to a full
# origin only if the UI is hosted somewhere the backend is not reachable
# same-origin AND the backend has CORS configured for it.
VITE_API_BASE_URL=

# Risk screen: day-loss limit (₹) to compare day P&L against. Mirrors the
# backend DAY_LOSS_LIMIT default; display-only, no enforcement here.
VITE_DAY_LOSS_LIMIT=10000

# Minutes after which a heartbeat is shown as STALE. Mirrors the backend
# stale-heartbeat watcher default.
VITE_STALE_MINUTES=2
