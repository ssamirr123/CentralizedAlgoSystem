# Production build config (committed — contains NO secrets).
# Used automatically by `vite build` (mode=production).
#
# The production site is served by CloudFront, which also proxies /api/*,
# /strategies and /health to the EC2 backend as extra origins. So the app
# calls the API *same-origin* over relative paths — no absolute URL, no
# CORS, and nothing environment-specific baked into the JS bundle beyond
# the trading mode below.
VITE_API_BASE_URL=

# Paper only. Anything other than the exact string "live" is treated as
# paper (fail safe). Live order execution is not implemented regardless.
VITE_TRADING_MODE=paper

# Risk-screen display values (mirror backend defaults; not enforcement).
VITE_DAY_LOSS_LIMIT=10000
VITE_STALE_MINUTES=2

# VITE_API_PROXY_TARGET is a dev-server-only setting (see vite.config.ts);
# it is not read by `vite build` and never reaches the bundle.
