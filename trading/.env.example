# Copy to .env (or export directly) before running an algo.
# Never commit a real .env file.

# --- Safety gate --------------------------------------------------------
# "paper"  -> PaperBroker or a real adapter with real orders blocked
# "live"   -> required before any real adapter will place a real order
TRADING_MODE=paper

# Which broker adapter to use: paper | zerodha | angelone | icici_breeze
BROKER=paper

# --- Identity / heartbeat reporting (existing monitoring backend) ------
STRATEGY_NAME=example_strategy
SERVER_NAME=local-dev
API_BASE_URL=http://127.0.0.1:8000
HEARTBEAT_INTERVAL_SECONDS=30

# --- Control-center heartbeat (POST /api/heartbeat, Milestone 8) -------
# Same API_BASE_URL as above -- the control-center API is mounted on the
# same deployed app. Leave CONTROL_API_KEY blank to skip this heartbeat
# sender entirely (the old one above still runs either way).
CONTROL_API_KEY=
CONTROL_HEARTBEAT_INTERVAL_SECONDS=10

# --- Strategy-specific (trading/algos/example_strategy/config.py) ------
STRATEGY_SYMBOL=NIFTY
STRATEGY_QUANTITY=1
STRATEGY_LOOP_INTERVAL_SECONDS=2

# --- Reconnect behavior --------------------------------------------------
BROKER_RECONNECT_MAX_ATTEMPTS=5
BROKER_RECONNECT_BACKOFF_SECONDS=2.0

LOG_LEVEL=INFO

# --- Zerodha Kite Connect (only needed if BROKER=zerodha) --------------
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_ACCESS_TOKEN=

# --- AngelOne SmartAPI (only needed if BROKER=angelone) -----------------
ANGELONE_API_KEY=
ANGELONE_CLIENT_ID=
ANGELONE_PASSWORD=
ANGELONE_TOTP_SECRET=

# --- ICICI Direct Breeze (only needed if BROKER=icici_breeze) ----------
ICICI_BREEZE_API_KEY=
ICICI_BREEZE_API_SECRET=
ICICI_BREEZE_SESSION_TOKEN=
