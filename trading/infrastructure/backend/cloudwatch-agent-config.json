{
  "//": "Amazon CloudWatch agent config for the Backend EC2. Install: `sudo dnf install -y amazon-cloudwatch-agent` (AL2023) then put this at /opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json and `sudo /opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl -a fetch-config -m ec2 -s -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json`. Needs the CloudWatchAgentServerPolicy grants that iam_backend_role_policy.json's CloudWatchAgent stanza covers.",
  "agent": {
    "metrics_collection_interval": 60,
    "run_as_user": "cwagent"
  },
  "metrics": {
    "namespace": "CentralizedAlgo/Backend",
    "append_dimensions": {
      "InstanceId": "${aws:InstanceId}"
    },
    "metrics_collected": {
      "cpu": { "measurement": ["cpu_usage_idle", "cpu_usage_iowait"], "totalcpu": true },
      "mem": { "measurement": ["mem_used_percent"] },
      "disk": { "measurement": ["used_percent"], "resources": ["/"] },
      "diskio": { "measurement": ["io_time"], "resources": ["*"] },
      "swap": { "measurement": ["swap_used_percent"] }
    }
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/nginx/access.log",
            "log_group_name": "/centralized-algo/backend/nginx-access",
            "log_stream_name": "{instance_id}"
          },
          {
            "file_path": "/var/log/nginx/error.log",
            "log_group_name": "/centralized-algo/backend/nginx-error",
            "log_stream_name": "{instance_id}"
          },
          {
            "file_path": "/var/log/centralized-algo/healthcheck.log",
            "log_group_name": "/centralized-algo/backend/healthcheck",
            "log_stream_name": "{instance_id}"
          }
        ]
      }
    }
  }
}
