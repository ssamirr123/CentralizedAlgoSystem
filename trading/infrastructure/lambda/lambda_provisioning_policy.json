{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SSMSendCommandAnyInstance",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": [
        "arn:aws:ec2:ap-south-1:471112713822:instance/*",
        "arn:aws:ssm:ap-south-1::document/AWS-RunShellScript",
        "arn:aws:ssm:ap-south-1::document/AWS-RunPowerShellScript"
      ]
    },
    {
      "Sid": "EC2PowerControlAnyInstance",
      "Effect": "Allow",
      "Action": [
        "ec2:StartInstances",
        "ec2:StopInstances",
        "ec2:RebootInstances"
      ],
      "Resource": "arn:aws:ec2:ap-south-1:471112713822:instance/*"
    },
    {
      "Sid": "AttachProfileToInstance",
      "Effect": "Allow",
      "Action": [
        "ec2:AssociateIamInstanceProfile",
        "ec2:DescribeIamInstanceProfileAssociations"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PassRoleToEC2",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::471112713822:role/TradingEC2SSMRole",
      "Condition": {
        "StringEquals": { "iam:PassedToService": "ec2.amazonaws.com" }
      }
    }
  ]
}
