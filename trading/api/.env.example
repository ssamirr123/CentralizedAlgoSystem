# Environment variables for the control-center API (mounted onto
# backend/main.py, deployed on Vercel). Set these in Vercel's Project
# Settings -> Environment Variables, not in a committed file.

# Shared secret the dashboard/caller sends via the X-API-Key header.
# Auth fails CLOSED if this is unset (503, not "allow everything").
CONTROL_API_KEY=

# Milestone 5's schema reuses the same Supabase Postgres as the existing
# heartbeat monitor -- same DATABASE_URL already configured on Vercel.
DATABASE_URL=

# Milestone 4's orchestration Lambda.
LAMBDA_FUNCTION_NAME=TradingOrchestrator
AWS_REGION=ap-south-1

# Vercel functions have no IAM role to assume (unlike the EC2 instance) --
# use a dedicated IAM user scoped to ONLY lambda:InvokeFunction on
# TradingOrchestrator, not the trading-control-cli setup user.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
