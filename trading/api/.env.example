# Control-center API environment variables.
#
# In production these are set in /opt/centralized-algo/app/.env on the
# Backend EC2 (read by docker-compose; see
# trading/infrastructure/backend/). Locally, copy the repo-root
# .env.example instead -- this file is just a field reference.

# Shared secret for the machine identity (X-API-Key header). Human users
# authenticate with username/password -> JWT instead. Auth fails CLOSED
# if this is unset.
CONTROL_API_KEY=

# PostgreSQL, local to the Backend EC2 in production.
DATABASE_URL=postgresql://user:pass@localhost:5432/centralized_algo

# The orchestration Lambda the backend invokes for start/stop/restart.
LAMBDA_FUNCTION_NAME=TradingOrchestrator
AWS_REGION=ap-south-1
# No AWS access keys: the EC2 instance role supplies credentials
# (lambda:InvokeFunction on TradingOrchestrator).

# Auth (Stage 18). Required in production. See
# trading/infrastructure/backend/STAGE18_AUTH.md for the full list.
AUTH_SECRET_KEY=
AUTH_ALLOWED_ORIGINS=https://<your-cloudfront-domain>
AUTH_COOKIE_SECURE=true
